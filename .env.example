# Copy to .env.local for `node tools/dev-server.mjs`. Never commit real values.
# On Vercel, set the same names under Settings -> Environment Variables.

# PostgreSQL. Local: postgres://postgres:PASSWORD@localhost:5432/eimc   Vercel: the Neon integration sets it.
DATABASE_URL=

# Terminal licence signing (api/app/*). Production values live only in Vercel and a password
# manager. For local testing make a throwaway pair; tools/test-app-api.mjs does that for you.
EIMC_SIGNING_KEY_ID=
EIMC_SIGNING_KEY=

# The market-data relay (eimc-relay), e.g. https://relay.yourdomain.com. Written into every live
# licence, so terminals know where to get live data. Leave empty until the relay is running.
RELAY_PUBLIC_URL=
